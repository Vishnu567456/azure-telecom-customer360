{
  "datasets": [
    {
      "catalog": "vishnu_telecom",
      "displayName": "Customer 360 KPIs",
      "name": "ds_kpis",
      "queryLines": [
        "SELECT MEASURE(customer_count) AS customers, MEASURE(active_subscribers) AS active_subscribers, MEASURE(monthly_recurring_revenue) AS monthly_revenue, MEASURE(avg_monthly_fee) AS avg_monthly_fee FROM customer_360_metrics"
      ],
      "schema": "gold"
    },
    {
      "catalog": "vishnu_telecom",
      "displayName": "Regional Performance",
      "name": "ds_region",
      "queryLines": [
        "SELECT region, MEASURE(customer_count) AS customers, MEASURE(monthly_recurring_revenue) AS monthly_revenue FROM customer_360_metrics GROUP BY ALL ORDER BY monthly_revenue DESC"
      ],
      "schema": "gold"
    },
    {
      "catalog": "vishnu_telecom",
      "displayName": "Customer 360 Detail",
      "name": "ds_customers",
      "queryLines": [
        "SELECT customer_id, customer_name, email, region, segment, subscription_status, plan_name, monthly_fee, data_gb FROM customer_360 ORDER BY customer_id"
      ],
      "schema": "gold"
    }
  ],
