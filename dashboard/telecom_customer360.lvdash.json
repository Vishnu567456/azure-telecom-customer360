{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "Customer 360 KPIs",
      "queryLines": [
        "SELECT MEASURE(customer_count) AS customers, ",
        "MEASURE(active_subscribers) AS active_subscribers, ",
        "MEASURE(monthly_recurring_revenue) AS monthly_revenue, ",
        "MEASURE(avg_monthly_fee) AS avg_monthly_fee ",
        "FROM customer_360_metrics"
      ]
    },
    {
      "name": "ds_region",
      "displayName": "Regional Performance",
      "queryLines": [
        "SELECT region, ",
        "MEASURE(customer_count) AS customers, ",
        "MEASURE(monthly_recurring_revenue) AS monthly_revenue ",
        "FROM customer_360_metrics ",
        "GROUP BY ALL ",
        "ORDER BY monthly_revenue DESC"
      ]
    },
    {
      "name": "ds_customers",
      "displayName": "Customer 360 Detail",
      "queryLines": [
        "SELECT customer_id, customer_name, email, region, segment, ",
        "subscription_status, plan_name, monthly_fee, data_gb ",
        "FROM customer_360 ",
        "ORDER BY customer_id"
      ]
    }
  ],
  "pages": [
